[{"name":"app.R","content":"library(shiny)\r\nlibrary(bslib)\r\nlibrary(highcharter)\r\nlibrary(dplyr)\r\n\r\napp_theme <- bs_theme(\r\n  version = 5,\r\n  bootswatch = \"flatly\",\r\n  primary = \"#47475c\",\r\n  secondary = \"#73738c\",\r\n  success = \"#a3edba\",\r\n  bg = \"#f7f8fb\",\r\n  fg = \"#47475c\"\r\n)\r\n\r\ngeojson <- download_map_data(\"custom/world-robinson-highres\")\r\n\r\ndata <- get_data_from_map(geojson) %>%\r\n  select(`hc-key`)\r\n\r\nui <- page_sidebar(\r\n  title = \"Map loading performance\",\r\n  theme = app_theme,\r\n  sidebar = sidebar(\r\n    title = \"Map source\",\r\n    selectInput(\r\n      \"sel\",\r\n      \"Rendering strategy\",\r\n      c(\"Preloaded map\" = \"preload\", \"Sending map\" = \"send\")\r\n    ),\r\n    actionButton(\"action\", \"Generate map\", class = \"btn-primary\")\r\n  ),\r\n  tags$script(src = \"https://code.highcharts.com/mapdata/custom/world-robinson-highres.js\"),\r\n  card(\r\n    full_screen = TRUE,\r\n    card_header(\"World map\"),\r\n    highchartOutput(\"hcmap\")\r\n  )\r\n)\r\n\r\nserver <- function(input, output) {\r\n  output$hcmap <- renderHighchart({\r\n    input$action\r\n\r\n    data <- mutate(data, value = round(100 * runif(nrow(data)), 2))\r\n\r\n    if (input$sel == \"preload\") {\r\n      mapdata <- JS(\"Highcharts.maps['custom/world-robinson-highres']\")\r\n    } else {\r\n      mapdata <- geojson\r\n    }\r\n\r\n    highchart(type = \"map\") %>%\r\n      hc_add_series(\r\n        mapData = mapdata,\r\n        data = data,\r\n        joinBy = c(\"hc-key\"),\r\n        borderWidth = 0\r\n      ) %>%\r\n      hc_chart(zoomType = \"xy\") %>%\r\n      hc_colorAxis(stops = color_stops())\r\n  })\r\n}\r\n\r\nshinyApp(ui, server)\r\n","type":"text"},{"name":"DESCRIPTION","content":"Title: Highcharts Map Loading Performance\r\nDescription: Compare a preloaded Highcharts map with map data transferred from the Shiny server.\r\nCategories: maps, performance, data loading\r\n","type":"text"},{"name":"Readme.md","content":"This `bslib` dashboard compares two ways of supplying map geometry to a Highcharter map.\r\n\r\n- **Preloaded map:** the browser loads the Highcharts map collection once and the chart references it by name.\r\n- **Transferred map:** the Shiny server sends the complete map data with the chart.\r\n\r\nThe example helps illustrate how preloading large map assets can reduce repeated data transfer.\r\n","type":"text"},{"name":"screenshot.png","content":"iVBORw0KGgoAAAANSUhEUgAABaAAAAOECAIAAADYLwGFAAAQAElEQVR4nOzdC3iV5YHo+zcQ\nKggi1yRAlAqnUEFBAQFvqHSLYEvRVmerZ9tWqTrW1uo5tnNwWh1xT9mdcQ8dZ9RqpbZ1HnWP\ntoJY0TjFUdECchEotOKg5RJIuIvcLMGcdV8rIVyC4fLK7/cwMVnfZX1rhc7zfH/e913FP/jB\nfQEAAAAgZs0CAAAAQOQEDgAAACB6AgcAAAAQPYEDAAAAiJ7AAQAAAERP4AAAAACiJ3AAAAAA\n0RM4AAAAgOgJHAAAAED0BA4AAAAgegIHAAAAED2BAwAAAIiewAEAAABET+AAAAAAoidwAAAA\nANETOAAAAIDoCRwAAABA9AQOAAAAIHoCBwAAABA9gQMAAACInsABAAAARE/gAAAAAKIncAAA\nAADREzgAAACA6AkcAAAAQPQEDgAAACB6AgcAAAAQPYEDAAAAiJ7AAQAAAESv+EB3vPiavx3S\nOdSsmf4v//77bXvb6fizrv3aiO7Hhar5f//oa6GJ9britlG926yb/T+feDkcGqnXuPWdaf/8\n9NLET30u/+blfVvXrHrrF794szrEo2OvUaOH9StvnfjV7lz26v9+8u0AAAAAn3aNHMFR3GXw\npb32urXXsMGJuvFp0bpN8rUUF8f1inpcdvWoAeWJLvPOvLkL5y1eFQAAAOAYcMAjOFJqamra\n9D73sl5LJy/dc2Oni4f1bBc+Pd56/LEV3dvWLK/aEOLRo1e3xO9g/cJ/+8UrMY06AQAAgE+m\ncSM4dlat2xza9h42rHSPTa0HX9CvrHjrO8uqwqfG9uq46kZCy+JksqrZrW4AAABwTGncCI6w\nbdHs5R1GdO9z8eA5/zZ7e8GGHhcPLm9Zs2b6C1v69K57SMdeFw8f1Kdn5zapO++d65e/NvX5\ntyrT24aN/cGZbd6Z9ujstqNGDerZ6bjELjVb18x74fmXl24/gKtp32fU8Iv6lrVrmTp1zbbq\nxbMqpi5aXbjDxeee3bd7Wea5Ny577eVnZucLTNfBI0ed0zO1NXlh9VfaqLckx5XfvLz39jcn\nvrrz0uHn9OyQfM6abZVzpz/98nu5NUk69rlo1PDe3dodV/dt3fbObx59ZknBA32+9N2v9Nz6\nxj9Prr5o9Ig+3bIXUPDOJIpRt7NHXDC4d/59e3Pa9N8vz7wtF3/zu4PbLHv28eU9Lh/Styy5\n3EbV3F+t6Pa1wWWpzWVn/u0Pzkz8N3fxdS6spmZr1dLXXn55fva5GjzbpGmbMo8/W9Vn1KDe\nnY4L4aP1i1/9t2eXd7zo4tEDP9uuZUg+8s7MqU+/nXvPW3c//aJhg3p3a5v+nWxdtWja068t\n3Vbn1/1vi7tlX3XYuX5ZnVdd73e6c+PyuW9MfSXzDtd9FdsqF7w2ddrSyAoUAAAAh0bzYcNG\nHNCOPU8fVt76LxuW/ua5DT3POuWkLu02zFy6Lrux66gv