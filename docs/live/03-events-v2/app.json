[{"name":"app.R","content":"library(highcharter)\r\nlibrary(shiny)\r\nlibrary(bslib)\r\n\r\napp_theme <- bs_theme(\r\n  version = 5,\r\n  bootswatch = \"flatly\",\r\n  primary = \"#47475c\",\r\n  secondary = \"#73738c\",\r\n  success = \"#a3edba\",\r\n  bg = \"#f7f8fb\",\r\n  fg = \"#47475c\"\r\n)\r\n\r\nshinyApp(\r\n  ui = page_fluid(\r\n    title = \"Point events demo\",\r\n    theme = app_theme,\r\n    h2(\"Point events demo\"),\r\n    p(\"Move over or click a point to inspect the event payload.\"),\r\n    layout_columns(\r\n      col_widths = c(6, 3, 3),\r\n      card(\r\n        full_screen = TRUE,\r\n        card_header(\"Interactive chart\"),\r\n        highchartOutput(\"plot_hc\")\r\n      ),\r\n      card(\r\n        card_header(\"Clicked point\"),\r\n        uiOutput(\"click_ui\")\r\n      ),\r\n      card(\r\n        card_header(\"Hovered point\"),\r\n        uiOutput(\"mouseOver_ui\")\r\n      )\r\n    )\r\n  ),\r\n  server = function(input, output) {\r\n    df <- data.frame(x = 1:5, y = 1:5, otherInfo = letters[11:15])\r\n\r\n    output$plot_hc <- renderHighchart({\r\n      highchart() %>%\r\n        hc_add_series(df, \"scatter\") %>%\r\n        hc_add_event_point(event = \"click\") %>%\r\n        hc_add_event_point(event = \"mouseOver\")\r\n    })\r\n\r\n    observeEvent(input$plot_hc, print(paste(\"plot_hc\", input$plot_hc)))\r\n\r\n    output$click_ui <- renderUI({\r\n      if (is.null(input$plot_hc_click)) {\r\n        return(tags$p(class = \"text-muted\", \"Click a point.\"))\r\n      }\r\n\r\n      tags$p(\r\n        \"Coordinates: \",\r\n        tags$strong(input$plot_hc_click$x),\r\n        \", \",\r\n        tags$strong(input$plot_hc_click$y)\r\n      )\r\n    })\r\n\r\n    output$mouseOver_ui <- renderUI({\r\n      if (is.null(input$plot_hc_mouseOver)) {\r\n        return(tags$p(class = \"text-muted\", \"Move over a point.\"))\r\n      }\r\n\r\n      tags$p(\r\n        \"Coordinates: \",\r\n        tags$strong(input$plot_hc_mouseOver$x),\r\n        \", \",\r\n        tags$strong(input$plot_hc_mouseOver$y)\r\n      )\r\n    })\r\n  }\r\n)\r\n","type":"text"},{"name":"DESCRIPTION","content":"Title: Point Events Demo\r\nDescription: See how point click and mouseover events update reactive Shiny interface elements.\r\nCategories: events, interactivity, shiny\r\n","type":"text"},{"name":"Readme.md","content":"This compact `bslib` example shows how point events from a Highcharter chart become reactive Shiny inputs.\r\n\r\n- Clicking a point displays its coordinates in a card.\r\n- Moving the pointer over a point displays the current hover coordinates.\r\n- The input names are derived from the chart output ID and the event type.\r\n","type":"text"},{"name":"screenshot.png","content":"iVBORw0KGgoAAAANSUhEUgAABaAAAAJKCAIAAABVunX1AAAQAElEQVR4nOzdC3hV5YEv/KWG\nS1BCiZQkIOAYekqPMCMRk45QB46XWmO9jHDO6Bn1Ubwxota23scbVsVLpypYQEUPOEf7DThe\naqij8kAtOCVicAo9xdE4AmISGkIJyi1gv31Ndq4kISGs8Ps9PLr23uu+115Z73+977vSduys\nCQAAAADC7PAAAAAAIOQEHAAAAEDoCTgAAACA0BNwAAAAAKEn4AAAAABCT8ABAAAAhJ6AAwAA\nAAg9AQcAAAAQemlBOFWWzP+nWavK96QNGX/5LZd+q08ArVVWNO2OhVtig/0veOCuwpwAAACA\nsGtjwFH2+u23Ly5vYXbpffv0y8zNG3n6uL8ZkdMj6CRlr//TjFWx1dizYelT/zT0zn+ckBkA\nAAAAh6oOrsGxZ8e26h3bVi1at2pRUVr2iIlXXHJGbnrQ4coqUkOWT9Z+GnRSwLF947KixR9u\n7Zs/6fxR/QLaaMf6ZW+8tXZbv4LzJo7KCAAAAKDT7EcfHGm9MzL61vuXXi8u2VO+9hc/uesn\nb24MOtyAzKNTXh034tigc5QVzX120arly1ev3x7QZmVvzJ77zvLlq0rW7wgAAACgM+1HDY68\nSY9NyWv0bk1lafGiF15f+snO2Ms9n7z46E96dHQTkqHn33Ldtto+OH7Yae1Tyiq3BLRbWVV5\nAAAAAAdCh3cy2mNA7thL7hx7etGDdyzcFH/rk/kvrBg3taBDe+QYkHfJA09fEnSuirL1Ae1W\nVtYJlXcAAACgKZ31mNicwh9MHV2bnpS+taQqCJ9NG9RA2A+V69V/AQAA4ADprIAjCNLzCvNr\nO5b8ZMXqrUHYbK2qDGi36kq7DwAAgAOl8wKOIMgdMaJ2uGxjWRA226t0Lboftm22+wAAADhQ\nOrwPjlQDh2QHxfFWHjt2NF3aralYu+TdRctWlZZt27En9k5674wBg8edcfbpBcf2a77bjpJZ\nN84sjg1ln3r/g2fnNP3pwL974LYzchILKnnzlVff/LSsemd0OWm9s3O/Nf68syeMyGywkPVL\n5r+64tPSsj0127clH/6x5aXbb3yp3lgjpz43OS9ovZqtpcVvvfLOstKq6vh2pvXOyIlt5rhj\nGzx/du0zNz28PDZO+sipj07O69PynKuWTX/w2Q9j44+8cM6P8htsTk3Z6jeLFi9fvbG